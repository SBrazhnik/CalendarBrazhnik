<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6–11: автоматическая резервная копия настроек на Google Диск -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
    <!-- Фото документов в облако не уходят -->
    <exclude domain="file" path="docs/" />
    <!-- Токен Telegram-бота и копии файла данных в облако не уходят -->
    <exclude domain="sharedpref" path="telegram.xml" />
        <exclude domain="sharedpref" path="devreq.xml" />
    <exclude domain="file" path="work.json.tmp" />
</full-backup-content>
