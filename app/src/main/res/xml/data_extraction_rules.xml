<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: резервная копия в облако и перенос на новый телефон -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <!-- Фото документов в облако не уходят, только при прямом переносе на новый телефон -->
        <exclude domain="file" path="docs/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
